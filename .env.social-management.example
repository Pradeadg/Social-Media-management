# OPTIONAL Social Hub configuration. Copy only needed entries into .env.
# No model is downloaded and no paid API fallback is used.
PRADEA_OLLAMA_URL=http://127.0.0.1:11434

# Leave false until you have a local model, reviewed FAQ, HTTPS webhook,
# correct Meta app permissions, and have tested messaging on your own accounts.
PRADEA_SMM_MESSAGING_ENABLED=false
PRADEA_SMM_OWNER_ORG_ID=
PRADEA_SMM_FB_PAGE_ID=
PRADEA_SMM_IG_ACCOUNT_ID=
PRADEA_SMM_PAGE_TOKEN=
PRADEA_SMM_VERIFY_TOKEN=
PRADEA_META_GRAPH_VERSION=v24.0
# Uses the existing FACEBOOK_APP_SECRET from .env; never put secrets in frontend.
# Webhook: <public backend HTTPS URL>/social-management-webhook/meta
# If you later add an HTTPS reverse proxy, route this path to backend port 3000.
